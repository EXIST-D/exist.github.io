---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import { getAllTopics } from '../utils/content';
import { withBase } from '../utils/url';
import homeData from '../content/site/home.json';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const selectedProjects = projects.filter((entry) => ['pixelcampus', 'weijin', 'interview-bank', 'gleaner'].includes(entry.slug));
const topics = getAllTopics(notes);
---
<BaseLayout>
  <section class="container home-profile" aria-label="个人简介与近期动态">
    <div class="profile-intro">
      <p class="profile-greeting"><span class="status-dot" aria-hidden="true"></span>你好，欢迎来到我的博客</p>
      <div class="profile-name"><h1>{siteConfig.name}</h1><span>EXIST-D</span></div>
      <p class="profile-lead">应用统计硕士在读 · AI 应用与 Agent 开发</p>
      <ul class="hero-profile">
        {homeData.heroProfile.map((item) => <li><span class="profile-icon" aria-hidden="true">{item.icon}</span><span>{item.text}</span></li>)}
      </ul>
      <a class="hero-github" href={siteConfig.github} target="_blank" rel="noreferrer"><Icon name="code" size={17} />GitHub 主页：github.com/EXIST-D</a>
      <div class="button-row">
        <a class="button primary" href="#recent-projects">查看项目作品 <Icon name="arrow" size={17} /></a>
        <a class="button ghost" href={withBase('/notes')}><Icon name="book" size={17} />阅读学习笔记</a>
      </div>
      <div class="profile-footer"><span><Icon name="location" size={14} />{siteConfig.location}</span><span class="availability"><span class="status-dot" aria-hidden="true"></span>{siteConfig.availability}</span></div>
    </div>
    <aside class="profile-now" aria-labelledby="now-title">
      <div class="now-heading"><h2 id="now-title">{homeData.nowSection.title}</h2><time datetime={homeData.nowSection.updatedAt}>更新于 {homeData.nowSection.updatedAt.slice(0, 7).replace('-', '.')}</time></div>
      <ul class="now-list">
        {homeData.nowSection.items.map((item) => (
          <li><a href={withBase(item.href)}><h3>{item.title}</h3><p>{item.description}</p></a></li>
        ))}
      </ul>
      <a class="text-link now-about" href={withBase('/about#tech-stack')}>了解我的技术栈与背景</a>
    </aside>
  </section>

  <section class="container product-grid" aria-label="在线项目">
    {homeData.onlineProducts.map((product) => (
      <article class:list={['product-strip', `product-${product.tone}`]}>
        <span class="product-symbol" aria-hidden="true">{product.symbol}</span>
        <div><div class="product-title"><h2>{product.name}</h2><span class="small-badge">{product.status}</span></div><p>{product.description}</p></div>
        <a class="button ghost" href={product.url} target="_blank" rel="noreferrer">{product.action}</a>
      </article>
    ))}
  </section>

  <section class="section container" id="recent-projects">
    <header class="section-header"><div><span class="section-icon"><Icon name="code" /></span><h2>{homeData.projectSection.title}</h2><span class="count-badge">{projects.length}</span></div><a class="text-link" href={withBase('/projects')}>全部项目 <Icon name="arrow" size={16} /></a></header>
    <div class="project-grid">{selectedProjects.map((project) => <ProjectCard project={project} />)}</div>
    <div class="more-projects"><span>还有一些实践</span><a href={withBase('/projects/medstatforge')}>MedStatForge</a><a href={withBase('/projects/medical-analysis-orchestrator')}>医学分析编排</a><a href={withBase('/projects/spss-academic-workflow')}>SPSS Workflow</a><a href={withBase('/projects/floatnote')}>FloatNote</a></div>
  </section>

  <section class="section container home-writing">
    <div>
      <header class="section-header"><div><span class="section-icon"><Icon name="book" /></span><h2>学习与记录</h2></div><a class="text-link" href={withBase('/notes')}>全部笔记 <Icon name="arrow" size={16} /></a></header>
      <div class="note-list">{notes.slice(0, 3).map((note) => <NoteCard note={note} />)}</div>
    </div>
    <aside class="home-sidebar">
      <div class="sidebar-panel"><h2><Icon name="tag" size={18} />按主题阅读</h2><div class="topic-cloud">{topics.map((topic) => <a class="topic-link" href={withBase(`/topics/${topic.slug}`)}>{topic.name}<small>{topic.count}</small></a>)}</div><a class="text-link" href={withBase('/topics')}>全部专题 <Icon name="arrow" size={15} /></a></div>
      <div class="sidebar-panel about-snippet"><h2>关于我</h2><p>{homeData.aboutSection.summary}</p><div class="stat-grid-compact"><span><strong>{projects.length}</strong>项目作品</span><span><strong>{notes.length}</strong>公开笔记</span><span><strong>{topics.length}</strong>阅读主题</span></div><a class="text-link" href={withBase('/about')}>关于我的更多信息 <Icon name="arrow" size={15} /></a></div>
    </aside>
  </section>
</BaseLayout>
