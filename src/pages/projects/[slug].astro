---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { siteConfig } from '../../site.config';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const title = `${entry.data.title} | ${siteConfig.name}`;
const url = new URL(withBase(`/projects/${entry.slug}`), Astro.site ?? siteConfig.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  description: entry.data.description,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
  },
  url,
  keywords: entry.data.stack.join(', '),
};
---

<BaseLayout title={title} description={entry.data.description} structuredData={structuredData}>
  <section class="page-hero">
    <div class="container detail-shell">
      <article>
        <header class="post-header">
          <a class="text-link back-link" href={withBase('/projects')}>← 全部项目</a>
          <p class="eyebrow">项目案例 · {entry.data.status}</p>
          <h1>{entry.data.title}</h1>
          <p>{entry.data.description}</p>
          <div class="project-meta">
            <span>{entry.data.period}</span>
            <span>{entry.data.role}</span>
            <span>{entry.data.outcome}</span>
          </div>
          <div class="project-stack">
            {entry.data.stack.map((item) => (
              <Tag label={item} />
            ))}
          </div>
          <div class="link-row">
            {entry.data.demo && <a class="button primary" href={entry.data.demo} target="_blank" rel="noreferrer">在线体验</a>}
            {entry.data.repo && <a class="button ghost" href={entry.data.repo} target="_blank" rel="noreferrer">源码仓库</a>}
          </div>
        </header>

        {entry.data.image && (
            <figure class="project-figure">
              <img src={withBase(entry.data.image)} alt={entry.data.imageAlt ?? entry.data.title} width="1440" height="900" loading="eager" />
              <figcaption>{entry.data.imageAlt}</figcaption>
            </figure>
        )}

        <div class="prose">
          <Content />
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
