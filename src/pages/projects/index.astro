---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectCategories, siteConfig } from '../../site.config';
import { withBase } from '../../utils/url';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`项目作品 | ${siteConfig.name}`} description="个人 Agent、文学 RAG、面试学习工具与医学统计自动化的开源项目案例。">
  <section class="page-hero">
    <div class="container">
      <a class="breadcrumb" href={withBase('/')}>首页 <span>/</span> 项目</a>
      <h1>项目作品<span class="page-title-en">Projects</span></h1>
      <p>个人 Agent、学习工具与研究自动化。这里记录我做了什么，如何实现，以及仍在探索的问题。</p>
      <a class="hero-live-link" href="https://exist.qd.je/" target="_blank" rel="noreferrer"><span class="live-dot" aria-hidden="true"></span>Interview Bank 在线测试中</a>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="project-filters" role="group" aria-label="按项目方向筛选">
        <button type="button" data-filter="all" aria-pressed="true">全部 <span>{projects.length}</span></button>
        {projectCategories.map((category) => <button type="button" data-filter={category.id} aria-pressed="false">{category.label} <span>{projects.filter((project) => project.data.category === category.id).length}</span></button>)}
      </div>
      <p class="filter-summary" role="status" aria-live="polite">显示全部 {projects.length} 个项目</p>
      <div class="all-projects">{projects.map((project) => <ProjectCard project={project} />)}</div>
    </div>
  </section>
</BaseLayout>

<script>
  const filterGroup = document.querySelector('.project-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-category]'));
  const summary = document.querySelector('.filter-summary');
  filterGroup?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-filter]');
    if (!button) return;
    const category = button.dataset.filter;
    filterGroup.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    let count = 0;
    cards.forEach((card) => {
      card.hidden = category !== 'all' && card.dataset.projectCategory !== category;
      if (!card.hidden) count += 1;
    });
    if (summary) summary.textContent = category === 'all' ? `显示全部 ${count} 个项目` : `显示 ${count} 个${button.childNodes[0].textContent?.trim()}项目`;
  });
</script>
