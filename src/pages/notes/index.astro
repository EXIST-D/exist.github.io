---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../site.config';
import { getAllTopics } from '../../utils/content';
import { withBase } from '../../utils/url';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const topics = getAllTopics(notes);
---
<BaseLayout title={`学习笔记 | ${siteConfig.name}`} description="公开记录学习过程、问题拆解与技术复盘。">
  <section class="page-hero container">
    <a class="breadcrumb" href={withBase('/')}>首页 <span>/</span> 笔记</a>
    <h1>学习笔记<span class="page-title-en">Blog & Notes</span></h1>
    <p>记录项目里的思考、技术选择，以及学习过程。</p>
  </section>
  <section class="container blog-layout">
    <div><div class="list-toolbar"><span>共 {notes.length} 篇公开笔记</span><span>按发布时间排序</span></div><div class="note-list">{notes.map((note) => <NoteCard note={note} />)}</div></div>
    <aside class="blog-sidebar"><div class="sidebar-panel"><h2><Icon name="tag" size={19} />阅读主题</h2><div class="topic-cloud">{topics.map((topic) => <a class="topic-link" href={withBase(`/topics/${topic.slug}`)}>{topic.name}<small>{topic.count}</small></a>)}</div><a class="text-link" href={withBase('/topics')}>查看全部专题 <Icon name="arrow" size={15} /></a></div><div class="sidebar-panel"><h2>保持更新</h2><p>通过 RSS 订阅，在你习惯的阅读器里查看新文章。</p><a class="text-link" href={withBase('/rss.xml')}>订阅 RSS <Icon name="arrow" size={15} /></a></div></aside>
  </section>
</BaseLayout>
