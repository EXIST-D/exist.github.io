---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { contactLinks, siteConfig, techHighlights } from '../site.config';
import { resolveInternalHref, withBase } from '../utils/url';
import homeData from '../content/site/home.json';
const directions = [
  { label: '个人 Agent 与 RAG', title: '让对话有上下文，让讨论有出处。', body: '在 WeiJin 中实践文学检索、人格版本、记忆治理与本地部署。', href: '/projects/weijin' },
  { label: '面试学习工具', title: '从零散素材，到能持续复习的题库。', body: 'Gleaner 负责发现与打包，Interview Bank 负责整理与研究，在线版承接日常阅读和练习。', href: '/projects/interview-bank' },
  { label: '研究与统计自动化', title: '保留研究过程中的证据与确认。', body: '以 MedStatForge、医学分析编排与 SPSS Skills，探索从数据、方案到统计交付的可追溯流程。', href: '/projects/medstatforge' },
];
---

<BaseLayout title={`关于我 | ${siteConfig.name}`} description="王明旭，中国地质大学（北京）应用统计硕士在读，关注 AI Agent、RAG、数据工程与研究流程自动化。">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">关于我 / ABOUT</p>
      <h1>你好，我是{siteConfig.name}。</h1>
      <p>{homeData.aboutSection.summary}</p>
    </div>
  </section>
  <section class="section">
    <div class="container about-content-grid">
      <div>
        <SectionHeading eyebrow="教育与方向" title="统计背景，工程实践。" />
        <ul class="about-facts">
          <li><span>学校与专业</span><strong>中国地质大学（北京）· 应用统计硕士</strong></li>
          <li><span>预计毕业</span><strong>2028 年</strong></li>
          <li><span>求职方向</span><strong>AI 应用开发 / 大模型开发 / 数据工程</strong></li>
          <li><span>所在地区</span><strong>{siteConfig.location}</strong></li>
        </ul>
        <div class="direction-list">{directions.map((item) => <article><p class="panel-label">{item.label}</p><h3>{item.title}</h3><p>{item.body}</p><a class="text-link" href={withBase(item.href)}>相关项目</a></article>)}</div>
      </div>
      <aside class="contact-panel">
        <p class="panel-label">联系我</p>
        <h2>聊聊项目与机会。</h2>
        <p>欢迎交流 AI 应用、Agent 开发、研究自动化，以及相关实习与工作机会。</p>
        <ul class="contact-list">{contactLinks.filter((item) => item.label !== '订阅').map((item) => <li><a href={resolveInternalHref(item.href)}>{item.label}</a></li>)}</ul>
        <a class="text-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <hr />
        <p class="panel-label">正在运行</p>
        <h3>Interview Bank 在线测试版</h3>
        <p>公开资料免登录阅读，欢迎体验并通过项目仓库反馈。</p>
        <a class="button primary" href="https://exist.qd.je/" target="_blank" rel="noreferrer">打开在线刷题站</a>
      </aside>
    </div>
  </section>
  <section class="section" id="tech-stack">
    <div class="container"><SectionHeading eyebrow="日常使用与项目实践" title="技术栈" /><ul class="about-tech-list">{techHighlights.map((item) => <li><strong>{item.title}</strong><span>{item.description}</span></li>)}</ul></div>
  </section>
</BaseLayout>
