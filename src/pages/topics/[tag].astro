---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { siteConfig } from '../../site.config';
import { getAllTopics, slugifyTag } from '../../utils/content';
import { formatDate } from '../../utils/format';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const topics = getAllTopics(notes);

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const topics = getAllTopics(notes);

  return topics.map((topic) => ({
    params: { tag: topic.slug },
    props: {
      topic,
      notes: notes
        .filter((entry) => entry.data.tags.some((tag) => slugifyTag(tag) === topic.slug))
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()),
    },
  }));
}

const { topic, notes: topicNotes } = Astro.props;
---

<BaseLayout title={`${topic.name} | ${siteConfig.name}`} description={`浏览 ${topic.name} 主题下的学习笔记与经验总结。`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">专题</p>
      <h1>{topic.name}</h1>
      <p>这里收集了与这个主题相关的公开笔记，方便按专题集中查看。</p>
    </div>
  </section>

  <section class="section">
    <div class="container article-shell">
      <div class="detail-shell">
        <div class="entry-list">
          {topicNotes.map((note) => (
            <article class="entry-item">
              <div class="entry-head">
                <div>
                  <p class="list-kicker">专题文章</p>
                  <h3><a href={`/notes/${note.slug}`}>{note.data.title}</a></h3>
                </div>
                <div class="entry-date">{formatDate(note.data.publishedAt)}</div>
              </div>
              <p>{note.data.description}</p>
              <div class="entry-tags">
                {note.data.tags.map((tag) => (
                  <Tag label={tag} />
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>

      <aside class="detail-sidebar">
        <div class="page-panel">
          <p class="panel-label">全部专题</p>
          <div class="topic-cloud">
            {topics.map((item) => (
              <a class:list={['topic-link', item.slug === topic.slug && 'is-current']} href={`/topics/${item.slug}`}>
                <span>{item.name}</span>
                <small>{item.count}</small>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
