---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';

const cmsUrl = 'https://app.pagescms.org';
const repoUrl = 'https://github.com/EXIST-D/exist.github.io';
---

<BaseLayout title="在线编辑 | 王明旭" description="通过 Pages CMS 在线维护笔记、项目与站点内容。">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">内容管理</p>
      <h1>在线编辑中心</h1>
      <p>
        这个站点使用 Pages CMS 在线编辑。正文采用 Markdown 原文保存，同时可直接输入 LaTeX 公式，例如
        <code>$E=mc^2$</code> 或 <code>$$\\int_0^1 x^2 dx$$</code>。
      </p>

      <div class="button-row">
        <a class="button primary" href={cmsUrl} target="_blank" rel="noreferrer">打开 Pages CMS</a>
        <a class="button ghost" href={repoUrl} target="_blank" rel="noreferrer">查看 GitHub 仓库</a>
        <a class="button ghost" href={withBase('/')}>返回首页</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div>
        <p class="panel-label">可编辑内容</p>
        <ul class="clean-list">
          <li>学习笔记：<code>src/content/notes</code></li>
          <li>项目作品：<code>src/content/projects</code></li>
          <li>站点设置：<code>src/content/site/settings.json</code></li>
          <li>首页文案：<code>src/content/site/home.json</code></li>
        </ul>
      </div>

      <div>
        <p class="panel-label">权限说明</p>
        <ul class="clean-list">
          <li>只有 GitHub 仓库协作者可以保存修改。</li>
          <li>如果要给别人写权限，需要你在 GitHub 仓库里单独授权。</li>
          <li>建议同时保护 <code>main</code> 分支，避免未授权直写。</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
