---
import '../../styles/global.css';
import '../../styles/admin.css';
import 'katex/dist/katex.min.css';

const editorConfig = {
  owner: 'EXIST-D',
  repo: 'exist.github.io',
  branch: 'main',
  siteUrl: 'https://exist-d.github.io/exist.github.io/',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#0a111b" />
    <title>在线编辑器 | 王明旭</title>
    <meta
      name="description"
      content="飞书式在线 Markdown 编辑器，支持实时预览、KaTeX 数学公式和 GitHub 保存。"
    />
    <link rel="icon" type="image/svg+xml" href="/exist.github.io/favicon.svg" />
  </head>
  <body class="admin-page">
    <div class="admin-shell" data-admin-app data-config={JSON.stringify(editorConfig)}>
      <header class="admin-topbar">
        <div class="admin-brand">
          <span class="admin-brand-mark">01</span>
          <div>
            <strong>在线编辑器</strong>
            <p>Markdown + LaTeX 实时预览，保存到 GitHub 仓库</p>
          </div>
        </div>

        <div class="admin-top-actions">
          <a class="admin-link" href="/exist.github.io/">返回站点</a>
          <button class="admin-button ghost" type="button" data-action="reload-tree">刷新文件</button>
          <button class="admin-button" type="button" data-action="save">保存到 GitHub</button>
        </div>
      </header>

      <section class="admin-toolbar">
        <div class="admin-format-group" aria-label="格式工具栏">
          <button class="admin-button ghost" type="button" data-format="bold">加粗</button>
          <button class="admin-button ghost" type="button" data-format="italic">斜体</button>
          <button class="admin-button ghost" type="button" data-format="heading2">H2</button>
          <button class="admin-button ghost" type="button" data-format="quote">引用</button>
          <button class="admin-button ghost" type="button" data-format="code">代码块</button>
          <button class="admin-button ghost" type="button" data-format="list">列表</button>
        </div>

        <div class="admin-status" data-status>正在初始化编辑器...</div>
      </section>

      <main class="admin-grid">
        <aside class="admin-sidebar">
          <section class="admin-card">
            <div class="admin-card-head">
              <h2>授权</h2>
              <span class="admin-pill" data-auth-pill>未连接</span>
            </div>

            <label class="admin-label" for="github-token">GitHub Token</label>
            <input
              id="github-token"
              class="admin-input"
              data-token-input
              type="password"
              autocomplete="off"
              placeholder="粘贴你的 fine-grained PAT"
            />
            <p class="admin-help">
              只要你有 <code>EXIST-D</code> 仓库写权限，就可以保存。为了安全，Token 只保存在你的浏览器本地。
            </p>
            <div class="admin-inline-actions">
              <button class="admin-button" type="button" data-action="connect">连接 GitHub</button>
              <button class="admin-button ghost" type="button" data-action="clear-token">清除</button>
            </div>
            <p class="admin-meta" data-user-meta>尚未授权</p>
          </section>

          <section class="admin-card">
            <div class="admin-card-head">
              <h2>文件</h2>
              <span class="admin-pill" data-file-count>0</span>
            </div>
            <label class="admin-label" for="file-search">搜索</label>
            <input id="file-search" class="admin-input" data-file-search type="search" placeholder="按标题或路径筛选" />
            <div class="admin-file-actions">
              <button class="admin-button ghost" type="button" data-action="new-note">新建笔记</button>
              <button class="admin-button ghost" type="button" data-action="new-project">新建项目</button>
            </div>

            <div class="admin-file-groups">
              <section class="admin-file-group">
                <h3>学习笔记</h3>
                <div class="admin-file-list" data-file-list-notes></div>
              </section>
              <section class="admin-file-group">
                <h3>项目作品</h3>
                <div class="admin-file-list" data-file-list-projects></div>
              </section>
            </div>
          </section>

          <section class="admin-card admin-outline-card">
            <div class="admin-card-head">
              <h2>当前目录</h2>
              <span class="admin-pill">实时</span>
            </div>
            <ol class="admin-outline" data-outline></ol>
          </section>
        </aside>

        <section class="admin-pane admin-editor-pane">
          <div class="admin-pane-head">
            <div>
              <p class="admin-pane-kicker">Markdown 源码</p>
              <h2 data-file-title>尚未选择文件</h2>
            </div>
            <div class="admin-pane-meta" data-file-meta>先从左侧文件列表中打开一篇内容。</div>
          </div>

          <textarea
            class="admin-editor"
            data-editor
            spellcheck="false"
            placeholder="选择左侧文件后开始编辑。支持标准 Markdown、KaTeX 公式，以及保存到 GitHub。"
          ></textarea>
        </section>

        <section class="admin-pane admin-preview-pane">
          <div class="admin-pane-head">
            <div>
              <p class="admin-pane-kicker">实时预览</p>
              <h2>效果反馈</h2>
            </div>
            <div class="admin-pane-meta" data-preview-meta>实时渲染</div>
          </div>

          <article class="prose admin-preview" data-preview></article>
        </section>
      </main>
    </div>

    <script is:inline src="../vendor/markdown-it.min.js"></script>
    <script is:inline src="../vendor/katex.min.js"></script>
    <script is:inline src="../vendor/auto-render.min.js"></script>
    <script is:inline type="module" src="../scripts/admin-editor.mjs"></script>
  </body>
</html>
