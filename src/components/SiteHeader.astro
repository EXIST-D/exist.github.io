---
import { navLinks, siteConfig } from '../site.config';
import { withBase, withoutBase } from '../utils/url';
import Icon from './Icon.astro';
const pathname = withoutBase(Astro.url.pathname);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand-mark" aria-hidden="true">W<span>.</span></span>
      <span class="brand-copy"><strong>{siteConfig.name}<span class="brand-suffix"> / EXIST-D</span></strong><small>{siteConfig.role}</small></span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {navLinks.map((item) => {
        const active = pathname === item.href || (item.href !== '/' && pathname.startsWith(`${item.href}/`));
        return <a class:list={['nav-link', active && 'is-active']} aria-current={active ? 'page' : undefined} href={withBase(item.href)}>{item.label}</a>;
      })}
    </nav>
    <div class="header-actions">
      <button type="button" class="icon-button" data-open-search aria-label="搜索项目与笔记" title="搜索（Ctrl K）"><Icon name="search" /></button>
      <a class="nav-product" href="https://exist.qd.je/" target="_blank" rel="noreferrer">在线刷题</a>
    </div>
  </div>
</header>
