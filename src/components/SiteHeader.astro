---
import { navLinks, siteConfig } from '../site.config';
import { withBase, withoutBase } from '../utils/url';

const pathname = withoutBase(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand-mark">01</span>
      <span class="brand-copy">
        <strong>{siteConfig.name}</strong>
        <small>{siteConfig.role}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {navLinks.map((item) => (
        <a class:list={['nav-link', pathname === item.href && 'is-active']} href={withBase(item.href)}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
