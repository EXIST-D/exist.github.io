---
import type { CollectionEntry } from 'astro:content';
import { projectCategories } from '../site.config';
import { withBase } from '../utils/url';

interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const category = projectCategories.find((item) => item.id === project.data.category)?.label;
---

<article class:list={['work-card', compact && 'work-card-compact']} data-project-category={project.data.category}>
  {project.data.image && !compact && (
    <a class="work-image" href={withBase(`/projects/${project.slug}`)} tabindex="-1" aria-hidden="true">
      <img src={withBase(project.data.image)} alt="" loading="lazy" width="1440" height="900" />
    </a>
  )}
  <div class="work-body">
    <div class="work-heading">
      <span class="work-category">{category}</span>
      <span class="status-badge">{project.data.status}</span>
    </div>
    <h3><a href={withBase(`/projects/${project.slug}`)}>{project.data.title}</a></h3>
    <p class="work-description">{project.data.description}</p>
    {!compact && project.data.highlights.length > 0 && (
      <ul class="work-highlights">{project.data.highlights.map((item) => <li>{item}</li>)}</ul>
    )}
    <div class="work-stack" aria-label="使用技术">{project.data.stack.map((item) => <span>{item}</span>)}</div>
    <div class="link-row">
      <a class="text-link" href={withBase(`/projects/${project.slug}`)}>阅读案例 <span aria-hidden="true">↗</span></a>
      {project.data.demo && <a class="text-link" href={project.data.demo} target="_blank" rel="noreferrer">在线体验 ↗</a>}
      {project.data.repo && <a class="text-link muted-link" href={project.data.repo} target="_blank" rel="noreferrer">GitHub ↗</a>}
    </div>
  </div>
</article>
