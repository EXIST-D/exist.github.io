---
import type { CollectionEntry } from 'astro:content';
import { projectCategories } from '../site.config';
import { withBase } from '../utils/url';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const category = projectCategories.find((item) => item.id === project.data.category)?.label;
const badges: Record<string, { text: string; tone: string }> = {
  weijin: { text: '未', tone: 'blue' },
  'interview-bank': { text: 'IB', tone: 'orange' },
  gleaner: { text: 'G', tone: 'green' },
  medstatforge: { text: 'M', tone: 'purple' },
  'medical-analysis-orchestrator': { text: 'Rx', tone: 'blue' },
  'spss-academic-workflow': { text: 'S', tone: 'orange' },
  floatnote: { text: 'F', tone: 'green' },
};
const badge = badges[project.slug] ?? { text: '</>', tone: 'blue' };
---
<article class="project-card" data-project-category={project.data.category}>
  <div class="project-card-top">
    <span class:list={['project-symbol', `tone-${badge.tone}`]} aria-hidden="true">{badge.text}</span>
    <span class="project-status"><span class="status-dot" aria-hidden="true"></span>{project.data.status}</span>
  </div>
  <div class="project-heading"><h3><a href={withBase(`/projects/${project.slug}`)}>{project.data.title}</a></h3><span class="work-category">{category}</span></div>
  <p class="project-description">{project.data.description}</p>
  <div class="project-stack">{project.data.stack.slice(0, 5).map((item) => <span class="tag">{item}</span>)}</div>
  <div class="project-card-bottom">
    <p class="project-role">职责：{project.data.role}</p>
    <div class="project-links">
      <a class="text-link" href={withBase(`/projects/${project.slug}`)}>查看案例 <Icon name="arrow" size={16} /></a>
      <div>
        {project.data.demo && <a class="text-link" href={project.data.demo} target="_blank" rel="noreferrer">在线体验</a>}
        {project.data.repo && <a class="subtle-link" href={project.data.repo} target="_blank" rel="noreferrer" aria-label={`${project.data.title} GitHub 仓库`}>GitHub</a>}
      </div>
    </div>
  </div>
</article>
