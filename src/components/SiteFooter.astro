---
import { contactLinks, siteConfig } from '../site.config';
import { resolveInternalHref } from '../utils/url';
---
<footer class="site-footer container">
  <div class="footer-top"><a class="footer-brand" href={resolveInternalHref('/')}>{siteConfig.name}<span>EXIST-D</span></a><ul class="footer-links">{contactLinks.map((item) => <li><a href={resolveInternalHref(item.href)}>{item.label}</a></li>)}</ul></div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {siteConfig.name} · 个人博客与开源实践</span><span>用 Astro 构建，持续记录与更新。</span></div>
</footer>
